# Trivia Night — environment configuration
#
# Copy to `.env` for local overrides (it is gitignored). Every value below has
# a working default, so an empty file is a valid configuration for local play.
#
# In production, set these in your host's dashboard rather than in a file.

# ---------------------------------------------------------------------------
# Server (apps/server)
# ---------------------------------------------------------------------------

# Port the game server listens on.
# TRIVIA_PORT wins over PORT so an ambient PORT from a launcher can never drag
# the game server onto the web dev server's socket. Hosts that inject PORT
# (Render, Railway, Fly) work without any change.
# Default: 3001
TRIVIA_PORT=3001

# Set to "production" to serve the built client from the game server and to
# enable production logging. The npm scripts set this for you.
# Default: development
# NODE_ENV=production

# Comma-separated list of origins allowed to open a socket.
# ONLY needed for a split deployment, where the static site and the game server
# live on different hosts. If the server serves its own client (the default),
# everything is same-origin and this can stay unset.
# Example: ALLOWED_ORIGINS=https://trivia-night.pages.dev,https://trivianight.example
# Default: unset (any origin — safe here because the server uses no cookies,
# no credentials and no user accounts, but set it in production anyway)
# ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Client (apps/web) — must be prefixed VITE_ to reach the browser
# ---------------------------------------------------------------------------

# Where the browser should open its game socket.
# Leave EMPTY for same-origin, which is correct for:
#   - local development (Vite proxies /socket.io to the server)
#   - single-process production (the server serves the built client)
# Set it ONLY for a split deployment, to the public URL of the game server.
# Example: VITE_SERVER_URL=https://trivia-night-server.onrender.com
# Default: empty (same origin)
# VITE_SERVER_URL=
