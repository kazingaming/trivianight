{
  "name": "trivia-night",
  "private": true,
  "version": "0.1.0",
  "description": "Trivia Night - a reasoning-first estimation trivia game",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n worker,web -c magenta,cyan \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "npm run dev --workspace @trivia/worker",
    "dev:web": "npm run dev --workspace @trivia/web",
    "build": "npm run build --workspace @trivia/web",
    "start": "npm run build && npm run dev --workspace @trivia/worker",
    "serve": "npm run start",
    "deploy": "npm run build && npm run deploy --workspace @trivia/worker",
    "launch": "node scripts/launch.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "content:check": "tsx packages/content/scripts/check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.13"
  }
}
