{
  "name": "trivia-night",
  "private": true,
  "version": "0.1.0",
  "description": "Trivia Night - a reasoning-first estimation trivia game",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @trivia/server",
    "dev:web": "npm run dev --workspace @trivia/web",
    "build": "npm run build --workspace @trivia/web",
    "start": "cross-env NODE_ENV=production npm run start --workspace @trivia/server",
    "serve": "npm run build && npm run start",
    "launch": "node scripts/launch.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "content:check": "tsx packages/content/scripts/check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
